{
  "name": "offlinenet-backend",
  "version": "1.0.0",
  "description": "OfflineNet bundle server and scraper",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "scrape": "ts-node src/services/scraper.ts",
    "bundle": "ts-node src/services/bundler.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "puppeteer": "^24.4.0",
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.3.0",
    "uuid": "^11.1.0",
    "dotenv": "^16.4.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^5.0.3",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/archiver": "^6.0.3",
    "@types/uuid": "^10.0.0"
  }
}